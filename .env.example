# Copy this file to .env.local and fill in your Supabase project's values to
# enable Google/email auth + cloud sync. Without these, Veltra runs fully
# against local IndexedDB — every feature works, it just stays on this device.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Set as Supabase Edge Function secrets (not read by the app itself):
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set ANTHROPIC_MODEL=claude-sonnet-5   # optional
