# Copy this file to .env and fill in your Supabase project's values to
# enable cloud auth + sync. Without these, Veltra runs fully offline using
# local SQLite only — every feature works, it just won't sync across devices.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Set as Supabase Edge Function secrets (not read by the app itself):
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set ANTHROPIC_MODEL=claude-sonnet-5   # optional
